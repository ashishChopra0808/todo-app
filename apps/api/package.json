{
  "name": "@todo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=../../.env src/worker.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "otp": "node --env-file-if-exists=../../.env scripts/otp.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "@date-fns/tz": "^1.5.0",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.2.2",
    "@node-rs/argon2": "^2.2.2",
    "@sentry/node": "^11.14.0",
    "@todo/i18n": "workspace:*",
    "@todo/shared": "workspace:*",
    "@zxcvbn-ts/core": "^4.3.0",
    "@zxcvbn-ts/language-common": "^4.2.0",
    "@zxcvbn-ts/language-en": "^4.1.2",
    "better-auth": "^1.7.25",
    "bullmq": "^6.7.7",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "ioredis": "^6.0.0",
    "libphonenumber-js": "^1.13.16",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "sharp": "^0.35.5",
    "uuid": "^14.0.3",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "vitest": "^5.1.1"
  }
}
