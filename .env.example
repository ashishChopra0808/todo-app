# Copy to .env for local development:  cp .env.example .env
# Never commit .env. In staging/production set these in Railway / Cloudflare, not in files.

# --- Runtime ---
NODE_ENV=development
APP_ENV=development            # development | test | staging | production
PORT=3000
LOG_LEVEL=debug                # debug | info | warn | error

# --- Data stores (docker compose up -d gives you these) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/todo_dev
REDIS_URL=redis://localhost:6379/0

# --- Web origin (the API is served on the same origin under /api) ---
APP_ORIGIN=http://localhost:5173

# --- Secrets: long random strings (e.g. openssl rand -base64 48; on Railway use ${{secret(48)}}) ---
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DATA_ENCRYPTION_KEY=change-me-to-another-long-random-string-32-plus
IP_HASH_SALT=change-me-random-16-plus

# --- Google sign-in (optional in dev) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email: log | file | resend ---
EMAIL_DRIVER=file              # file = writes emails (with OTP codes) to OUTBOX_DIR
EMAIL_FROM=ToDo <no-reply@example.com>
RESEND_API_KEY=

# --- SMS: log | file | forward-email | msg91 ---
SMS_DRIVER=file
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
MSG91_INVITE_TEMPLATE_ID=       # second DLT template (group invites); phone invites are off without it
SMS_FORWARD_TO=                # staging only: SMS texts are emailed here until DLT approval
OUTBOX_DIR=.outbox

# --- File storage: local | s3 (Cloudflare R2 / MinIO) ---
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.storage
S3_ENDPOINT=                   # R2: https://<account-id>.r2.cloudflarestorage.com  MinIO: http://localhost:9000
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Proxy (staging/production: shared with the Cloudflare Pages function) ---
PROXY_SHARED_SECRET=
TRUST_PROXY_HOPS=1

# --- Monitoring ---
SENTRY_DSN=

RUN_WORKER_IN_PROCESS=true
RATE_LIMITS_ENABLED=true

# --- Owner review page (/admin): comma-separated emails of verified owner accounts ---
OWNER_EMAILS=

# --- Web app (Vite reads VITE_* at build time) ---
VITE_SENTRY_DSN=
VITE_APP_ENV=development
